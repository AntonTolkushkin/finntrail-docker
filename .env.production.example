# Production defaults for Debian/Ubuntu. host-nginx preserves the existing
# host Nginx on public ports 80/443. Use Traefik only when it is already edge.
APP_ENV=production
COMPOSE_PROJECT_NAME=bitrix-prod
TZ=Europe/Moscow
EDGE_MODE=host-nginx

# Nginx is exposed to Traefik through its Docker network. The loopback port is
# intentionally kept for local health checks and pre-DNS testing on the server.
NGINX_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8588
WWW_PATH=/srv/bitrix-prod/www
BACKUP_PATH=/srv/bitrix-prod/backups
SITE_ROOT=/opt/www/public_html

# Generated automatically by scripts/init-env.sh.
MYSQL_DATABASE=bitrix
MYSQL_USER=bitrix
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Values based on the current host. Recalculate them before deployment if the
# server has less than 24-32 GB RAM or also hosts memory-intensive services.
MYSQL_INNODB_BUFFER_POOL_SIZE=10G
MYSQL_MAX_CONNECTIONS=150
MYSQL_MAX_ALLOWED_PACKET=256M
MYSQL_TMP_TABLE_SIZE=64M
MYSQL_MAX_HEAP_TABLE_SIZE=64M
MYSQL_INNODB_FLUSH_LOG_AT_TRX_COMMIT=2

PHP_FPM_MAX_CHILDREN=60
PHP_FPM_START_SERVERS=12
PHP_FPM_MIN_SPARE_SERVERS=8
PHP_FPM_MAX_SPARE_SERVERS=24
PHP_FPM_MAX_REQUESTS=1000
PHP_MEMORY_LIMIT=1024M

LOG_MAX_SIZE=20m
LOG_MAX_FILE=10

PHP_IMAGE=quay.io/bitrix24/php:8.4.25-fpm-v1-alpine
NGINX_IMAGE=quay.io/bitrix24/nginx:1.30.4-v1-alpine
PERCONA_IMAGE=quay.io/bitrix24/percona-server:8.0.46-v1-rhel
REDIS_IMAGE=redis:8.2.9-alpine
NODE_IMAGE=node:22.13.1-alpine
TOOLS_UID=979
TOOLS_GID=979

# Used only when EDGE_MODE=traefik.
TRAEFIK_HOST_RULE='Host(`finntrail.ru`) || Host(`www.finntrail.ru`)'
TRAEFIK_NETWORK=proxy
TRAEFIK_ROUTER_NAME=finntrail-prod
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_HTTPS_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

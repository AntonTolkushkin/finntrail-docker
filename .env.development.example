# Server-side development stack: dev, dev1 and dev2 share one isolated DB.
APP_ENV=development
COMPOSE_PROJECT_NAME=bitrix-dev
TZ=Europe/Moscow
EDGE_MODE=host-nginx

NGINX_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8589
WWW_PATH=/srv/bitrix-dev/www
BACKUP_PATH=/srv/bitrix-dev/backups
SITE_ROOT=/opt/www/dev/public_html

MYSQL_DATABASE=bitrix_dev
MYSQL_USER=bitrix_dev
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

MYSQL_INNODB_BUFFER_POOL_SIZE=512M
MYSQL_MAX_CONNECTIONS=50
MYSQL_MAX_ALLOWED_PACKET=256M
MYSQL_TMP_TABLE_SIZE=32M
MYSQL_MAX_HEAP_TABLE_SIZE=32M
MYSQL_INNODB_FLUSH_LOG_AT_TRX_COMMIT=2

REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

PHP_FPM_MAX_CHILDREN=4
PHP_FPM_START_SERVERS=1
PHP_FPM_MIN_SPARE_SERVERS=1
PHP_FPM_MAX_SPARE_SERVERS=2
PHP_FPM_MAX_REQUESTS=500
PHP_MEMORY_LIMIT=384M

# Hard resource ceilings for the whole development stack.
DEV_MYSQL_CPUS=1.0
DEV_MYSQL_MEMORY_LIMIT=1536m
DEV_MYSQL_MEMORY_RESERVATION=768m
DEV_REDIS_CPUS=0.25
DEV_REDIS_MEMORY_LIMIT=256m
DEV_REDIS_MEMORY_RESERVATION=128m
DEV_PHP_CPUS=1.5
DEV_PHP_MEMORY_LIMIT=1536m
DEV_PHP_MEMORY_RESERVATION=512m
DEV_CRON_CPUS=0.25
DEV_CRON_MEMORY_LIMIT=384m
DEV_CRON_MEMORY_RESERVATION=128m
DEV_NGINX_CPUS=0.25
DEV_NGINX_MEMORY_LIMIT=256m
DEV_NGINX_MEMORY_RESERVATION=64m

DEV_BASIC_AUTH_USER=developer
DEV_BASIC_AUTH_PASSWORD=CHANGE_ME_DEV_BASIC_AUTH_PASSWORD

LOG_MAX_SIZE=10m
LOG_MAX_FILE=5

PHP_IMAGE=quay.io/bitrix24/php:8.4.25-fpm-v1-alpine
NGINX_IMAGE=quay.io/bitrix24/nginx:1.30.4-v1-alpine
PERCONA_IMAGE=quay.io/bitrix24/percona-server:8.0.46-v1-rhel
REDIS_IMAGE=redis:8.2.9-alpine
NODE_IMAGE=node:22.13.1-alpine
TOOLS_UID=979
TOOLS_GID=979

# Used only when EDGE_MODE=traefik.
TRAEFIK_HOST_RULE='Host(`dev.finntrail.ru`) || Host(`dev1.finntrail.ru`) || Host(`dev2.finntrail.ru`)'
TRAEFIK_NETWORK=proxy
TRAEFIK_ROUTER_NAME=finntrail-dev
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_HTTPS_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
